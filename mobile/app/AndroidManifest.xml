<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mlvc.cam"
    android:versionCode="1"
    android:versionName="0.1">

  <!-- 29: ASurfaceControl/ASurfaceTransaction, used for the HUD overlay layer. -->
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />

  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-feature android:name="android.hardware.camera" android:required="true" />

  <application android:label="GenZee" android:icon="@drawable/ic_launcher"
      android:hasCode="false" android:extractNativeLibs="true">
    <!-- fastrpc client for the Hexagon NPU. A vendor public library (listed in
         /vendor/etc/public.libraries.txt), but since API 31 an app must opt in
         explicitly or the QNN stub's dlopen fails with "libcdsprpc.so not
         found in namespace clns-N" - which is the real reason in-app QNN
         failed here, NOT an SELinux/sandbox block as first assumed. -->
    <uses-native-library android:name="libcdsprpc.so" android:required="false" />
    <activity android:name="android.app.NativeActivity"
        android:exported="true"
        android:screenOrientation="landscape"
        android:turnScreenOn="true"
        android:showWhenLocked="true"
        android:configChanges="orientation|screenSize|keyboardHidden">
      <meta-data android:name="android.app.lib_name" android:value="mlvccam" />
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
